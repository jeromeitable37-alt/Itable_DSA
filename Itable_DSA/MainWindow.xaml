<Window x:Class="Itable_DSA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Itable_DSA"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">
    <Grid Margin="10">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Shopping Cart System"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- AVAILABLE ITEMS GRID -->
        <DataGrid x:Name="ShoppingGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="0,54,618,10"
                  CanUserAddRows="False"
                  SelectionChanged="ShoppingGrid_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="120"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="150"/>

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- INPUT AREA -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">

            <WrapPanel>

                <!-- ID -->
                <StackPanel Margin="5">
                    <TextBlock Text="ID"/>
                    <TextBox x:Name="txtId"
                             Width="120"
                             Height="24"/>
                </StackPanel>

                <!-- NAME -->
                <StackPanel Margin="5">
                    <TextBlock Text="Name"/>
                    <TextBox x:Name="txtName"
                             Width="180"
                             Height="24"/>
                </StackPanel>

                <!-- DESCRIPTION -->
                <StackPanel Margin="5">
                    <TextBlock Text="Description"/>
                    <TextBox x:Name="txtDescription"
                             Width="180"
                             Height="24"/>
                </StackPanel>

                <!-- PRICE -->
                <StackPanel Margin="5">
                    <TextBlock Text="Price"/>
                    <TextBox x:Name="txtPrice"
                             Width="100"
                             Height="24"/>
                </StackPanel>

                <!-- SEARCH -->
                <StackPanel Margin="5">
                    <TextBlock Text="Search"/>
                    <DockPanel>

                        <TextBox x:Name="txtSearch"
         Width="180"
         Height="24"
         TextChanged="txtSearch_TextChanged"/>

                        <Button x:Name="btnSearch"
                                Content="🔍"
                                Width="35"
                                Height="24"
                                Margin="5,0,0,0"
                                Click="btnSearch_Click"/>

                    </DockPanel>
                </StackPanel>
                <!-- SORT -->
                <StackPanel Margin="5">
                    <TextBlock Text="Sort By"/>
                    <ComboBox x:Name="cmbSort"
              Width="150"
              Height="24"
              SelectionChanged="cmbSort_SelectionChanged">

                        <ComboBoxItem Content="ID Ascending"/>
                        <ComboBoxItem Content="ID Descending"/>
                        <ComboBoxItem Content="Name A-Z"/>
                        <ComboBoxItem Content="Name Z-A"/>
                        <ComboBoxItem Content="Price Low-High"/>
                        <ComboBoxItem Content="Price High-Low"/>

                    </ComboBox>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            Margin="15,20,0,0">

                    <!-- ADD -->
                    <Button x:Name="btnAdd"
                            Content="Add"
                            Width="90"
                            Height="35"
                            Margin="5"
                            Click="btnAdd_Click"
                            Background="#FF5C90F3"/>

                    <!-- REMOVE ITEM -->
                    <Button x:Name="btnRemove"
                            Content="Remove Item"
                            Width="100"
                            Height="35"
                            Margin="5"
                            Click="btnRemove_Click"
                            Background="#FF5C90F3"/>

                    <!-- CLEAR -->
                    <Button x:Name="btnClear"
                            Content="Clear"
                            Width="90"
                            Height="35"
                            Margin="5"
                            Click="btnClear_Click"
                            Background="#FF5C90F3"/>

                    <!-- ADD TO CART -->
                    <Button x:Name="btnAddtocart"
                            Content="Add to Cart"
                            Width="100"
                            Height="35"
                            Margin="5"
                            Click="btnaddtoCart_Click"
                            Background="#FF5C90F3"/>

                    <!-- REMOVE FROM CART -->
                    <Button x:Name="btnRemoveCart"
                            Content="Remove from Cart"
                            Width="140"
                            Height="35"
                            Margin="5"
                            Click="btnRemoveCart_Click"
                            Background="#FF5C90F3"/>

                </StackPanel>

            </WrapPanel>

        </Border>

        <!-- LABELS -->
        <Label Content="Available Items"
               HorizontalAlignment="Left"
               Height="36"
               Margin="139,13,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="172"
               FontWeight="Bold"
               FontSize="16"/>

        <Label Content="Shopping Cart"
               HorizontalAlignment="Left"
               Height="36"
               Margin="796,13,0,0"
               Grid.Row="1"
               VerticalAlignment="Top"
               Width="172"
               FontWeight="Bold"
               FontSize="16"/>

        <!-- CART GRID -->
        <DataGrid x:Name="AddtoCart"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="590,54,10,10"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="120"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="150"/>

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>
